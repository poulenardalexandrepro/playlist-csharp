<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PlaylistAppEF.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework de tests -->
    <PackageReference Include="Microsoft.NET.Test.Sdk"          Version="18.7.0" />
    <PackageReference Include="xunit"                           Version="2.9.3"   />
    <PackageReference Include="xunit.runner.visualstudio"       Version="3.1.5"   />
    <PackageReference Include="coverlet.collector"              Version="10.0.1"   />

    <!-- EF Core InMemory : BD en mémoire pour les tests (pas de SQLite requis) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
  </ItemGroup>

  <!-- Référencer le projet principal -->
  <ItemGroup>
    <ProjectReference Include="../PlaylistAppEF/PlaylistAppEF.csproj" />
  </ItemGroup>
</Project>
